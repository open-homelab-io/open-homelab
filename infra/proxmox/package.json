{
  "name": "open-homelab-proxmox",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "get": "TERRAFORM_BINARY_NAME=tofu bun --env-file=../../.env ./node_modules/cdktn-cli/bin/cdktn get",
    "synth": "TERRAFORM_BINARY_NAME=tofu bun --env-file=../../.env ./node_modules/cdktn-cli/bin/cdktn synth",
    "diff": "TERRAFORM_BINARY_NAME=tofu bun --env-file=../../.env ./node_modules/cdktn-cli/bin/cdktn diff",
    "deploy": "TERRAFORM_BINARY_NAME=tofu bun --env-file=../../.env ./node_modules/cdktn-cli/bin/cdktn deploy",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "cdktn": "0.23.4",
    "constructs": "10.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.1",
    "cdktn-cli": "0.23.4",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "follow-redirects": "1.16.0"
  }
}
